{
  "info": {
    "name": "Lab Task 02 - Course Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "fixtureDir",
      "value": "postman/fixtures"
    }
  ],
  "item": [
    {
      "name": "Get all courses",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/course"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response fields', function () { const body = pm.response.json(); pm.expect(body.message).to.eql('All courses fetched successfully'); pm.expect(body.data).to.eql([]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Get course by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/course/5"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response fields', function () { const body = pm.response.json(); pm.expect(body.id).to.eql('5'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Create course",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/course",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"NestJS Fundamentals\", \"code\": \"CS101\", \"instructor\": \"John Doe\", \"credits\": 3}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Response fields', function () { const body = pm.response.json(); pm.expect(body.data.credits).to.eql(3); pm.expect(body.data.name).to.eql('NestJS Fundamentals'); });"
            ]
          }
        }
      ]
    },
