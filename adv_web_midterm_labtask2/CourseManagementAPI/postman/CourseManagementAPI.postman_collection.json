    {
      "name": "Upload notes.pdf",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/course/5/upload",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "{{fixtureDir}}/notes.pdf"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', function () { pm.response.to.have.status(201); });",
              "pm.test('Response fields', function () { const body = pm.response.json(); pm.expect(body.courseId).to.eql('5'); pm.expect(body.filename).to.be.a('string'); pm.expect(body.path.replace(/\\\\/g, '/')).to.include('src/uploads/'); });"
            ]
          }
        }
      ]
